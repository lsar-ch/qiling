# ── 本地 AI 服务 ─────────────────────────────────────────────
# ai-service 默认只监听本机 127.0.0.1
DESKMATE_HOST=127.0.0.1
DESKMATE_PORT=8736

# 允许跨域的来源（开发模式 web/desktop），逗号分隔
# DESKMATE_CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost

# 当桌面运行时无法自动定位项目根目录时手动指定
# DESKMATE_HOME=/absolute/path/to/project

# ── LLM（Step 3）────────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen-plus

# ── 语音供应商（Step 4，详见 docs/VOICE-PROVIDERS.md）────────
# 阿里云百炼 DashScope：https://bailian.console.aliyun.com/ 获取 API Key
# DASHSCOPE_API_KEY=

# MiniMax：https://platform.minimaxi.com/ 获取 API Key（对话人格主声 TTS）
# MINIMAX_API_KEY=

# 火山引擎豆包语音（预留，Step 8 实测后接入）
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_CLUSTER=volcano_tts
# VOLC_VOICE_TYPE=

# 关闭语音 / 强制某一侧供应商
# VOICE_ENABLED=true
# VOICE_STT_PROVIDER=dashscope
# VOICE_TTS_PROVIDER=dashscope
# VOICE_TTS_VOICE=longxiaochun_v2
